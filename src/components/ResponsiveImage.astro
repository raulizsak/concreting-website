---
interface Props {
  src: string;
  alt: string;
  variant?: 'project' | 'hero';
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  sizes?: string;
  width?: number;
  height?: number;
  widths?: readonly number[];
  class?: string;
}

const {
  src,
  alt,
  variant = 'project',
  loading = 'lazy',
  fetchpriority = 'auto',
  sizes = variant === 'hero' ? '100vw' : '(min-width: 1024px) 50vw, 100vw',
  width = variant === 'hero' ? 1586 : 1200,
  height = variant === 'hero' ? 992 : 900,
  widths: suppliedWidths,
  class: className,
} = Astro.props;

const widths = suppliedWidths ?? (variant === 'hero' ? [480, 768, 1200, 1536] : [480, 800, 1200]);
const srcset = (format: string) => widths.map((imageWidth) => `${src}-${imageWidth}.${format} ${imageWidth}w`).join(', ');
---

<picture class={className}>
  <source type="image/avif" srcset={srcset('avif')} sizes={sizes} />
  <source type="image/webp" srcset={srcset('webp')} sizes={sizes} />
  <img
    src={`${src}-${widths[Math.min(1, widths.length - 1)]}.webp`}
    width={width}
    height={height}
    alt={alt}
    loading={loading}
    decoding="async"
    fetchpriority={fetchpriority}
  />
</picture>
