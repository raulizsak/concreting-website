---
import { ArrowUpRight, Mail, Phone } from '@lucide/astro';
import SocialLinks from './SocialLinks.astro';
import { siteConfig } from '../config/site';
---

<footer class="site-footer">
  <div class="footer-main container">
    <div class="footer-brand">
      <a href="/" class="footer-logo" aria-label={`${siteConfig.businessName} home`}>
        <img src="/logo/geli-construction-services-logo.webp" width="720" height="720" alt="" loading="lazy" />
        <span>{siteConfig.businessName}</span>
      </a>
      <p>Concreting and outdoor construction across selected areas of South-East Melbourne, the Dandenong Ranges, Gippsland, Bass Coast, South Gippsland and the Latrobe Valley.</p>
      <a class="footer-contact-link" href={siteConfig.phoneHref}><Phone size={18} aria-hidden="true" /> {siteConfig.phoneDisplay}</a>
      <a class="footer-contact-link" href={siteConfig.emailHref}><Mail size={18} aria-hidden="true" /> {siteConfig.emailDisplay}</a>
      <div class="footer-socials"><SocialLinks label="Follow us" variant="dark" /></div>
    </div>

    <div class="footer-columns">
      <div>
        <p class="footer-label">Navigate</p>
        <nav aria-label="Footer navigation">
          {siteConfig.nav.map((item) => <a href={item.href}>{item.label}</a>)}
          <a href="/privacy/">Privacy Policy</a>
        </nav>
      </div>
      <div>
        <p class="footer-label">Services</p>
        <nav aria-label="Services navigation">
          {siteConfig.services.map((service) => <a href={`/services/#${service.slug}`}>{service.name}</a>)}
        </nav>
      </div>
      <div>
        <p class="footer-label">Service area</p>
        <p>{siteConfig.serviceArea}</p>
        <a class="footer-quote" href="/contact/#quote-form">Request a quote <ArrowUpRight size={17} aria-hidden="true" /></a>
      </div>
    </div>
  </div>

  <div class="footer-base container">
    <p>© 2026 {siteConfig.businessName}. All rights reserved.</p>
    <p>ABN {siteConfig.abn}</p>
    <p>Website by NXT PC</p>
  </div>
</footer>

<style>
  .site-footer { padding: clamp(4rem, 8vw, 7rem) 0 1.5rem; background: #11100f; color: white; }
  .footer-main { display: grid; gap: 4rem; }
  .footer-brand { max-width: 30rem; }
  .footer-logo { display: flex; align-items: center; gap: .9rem; font-family: "Archivo Variable", sans-serif; font-size: clamp(1rem, 2.2vw, 1.55rem); font-weight: 760; letter-spacing: -.02em; line-height: 1.1; text-transform: uppercase; }
  .footer-logo img { width: 4.25rem; height: 4.25rem; flex: 0 0 auto; border-radius: 50%; object-fit: cover; }
  .footer-brand > p { margin: 1.25rem 0 1.5rem; color: rgba(255,255,255,.58); font-size: .9rem; }
  .footer-contact-link { display: flex; width: fit-content; align-items: center; gap: .6rem; margin-top: .7rem; color: var(--brand-primary); font-family: "Archivo Variable", sans-serif; font-size: .8rem; font-weight: 710; overflow-wrap: anywhere; }
  .footer-socials { margin-top: 1.25rem; }
  .footer-columns { display: grid; gap: 2.5rem; }
  .footer-label { margin: 0 0 1rem !important; color: rgba(255,255,255,.62) !important; font-family: "Archivo Variable", sans-serif; font-size: .65rem !important; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }
  .footer-columns nav { display: grid; gap: .65rem; }
  .footer-columns a, .footer-columns p { margin: 0 0 .7rem; color: rgba(255,255,255,.76); font-size: .84rem; }
  .footer-columns a:hover { color: var(--brand-primary); }
  .footer-quote { display: inline-flex; align-items: center; gap: .45rem; margin-top: .65rem !important; color: var(--brand-primary) !important; font-weight: 750; }
  .footer-base { display: flex; flex-direction: column; gap: .3rem; border-top: 1px solid rgba(255,255,255,.12); margin-top: 4rem; padding-top: 1.5rem; }
  .footer-base p { margin: 0; color: rgba(255,255,255,.56); font-size: .66rem; letter-spacing: .03em; }
  @media (min-width: 48rem) { .footer-columns { grid-template-columns: repeat(3, 1fr); } .footer-base { flex-direction: row; justify-content: space-between; } }
  @media (min-width: 64rem) { .footer-main { grid-template-columns: .8fr 1.2fr; } }
</style>
