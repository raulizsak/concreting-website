---
import ResponsiveImage from './ResponsiveImage.astro';

interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  sizes?: string;
  widths?: readonly number[];
}

const {
  src,
  alt,
  width = 1200,
  height = 900,
  loading = 'lazy',
  fetchpriority = 'auto',
  sizes,
  widths,
} = Astro.props;
const contained = width <= height;
---

<div class:list={['adaptive-project-image', { 'adaptive-project-image--contained': contained }]} data-contained={String(contained)}>
  {contained && (
    <span class="adaptive-project-image__backdrop" aria-hidden="true">
      <ResponsiveImage
        src={src}
        alt=""
        width={width}
        height={height}
        loading={loading}
        fetchpriority="low"
        sizes={sizes}
        widths={widths}
        class="adaptive-project-image__picture"
      />
    </span>
  )}
  <ResponsiveImage
    src={src}
    alt={alt}
    width={width}
    height={height}
    loading={loading}
    fetchpriority={fetchpriority}
    sizes={sizes}
    widths={widths}
    class="adaptive-project-image__foreground"
  />
</div>

<style>
  .adaptive-project-image { position: relative; width: 100%; height: 100%; overflow: hidden; }
  .adaptive-project-image :global(picture), .adaptive-project-image :global(img) { display: block; width: 100%; height: 100%; }
  .adaptive-project-image :global(.adaptive-project-image__foreground img) { object-fit: cover; }
  .adaptive-project-image--contained :global(.adaptive-project-image__foreground) { position: relative; z-index: 1; }
  .adaptive-project-image--contained :global(.adaptive-project-image__foreground img) { object-fit: contain; }
  .adaptive-project-image__backdrop { position: absolute; inset: -12%; transform: scale(1.08); filter: blur(34px) saturate(.62) brightness(.62); pointer-events: none; transition: transform .45s ease; }
  .adaptive-project-image__backdrop :global(img) { object-fit: cover; }
  @media (prefers-reduced-motion: reduce) { .adaptive-project-image__backdrop { transition: none; } }
</style>
