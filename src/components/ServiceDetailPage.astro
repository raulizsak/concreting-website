---
import { ArrowRight, Check, Phone } from '@lucide/astro';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
import ProjectCard from './ProjectCard.astro';
import ResponsiveImage from './ResponsiveImage.astro';
import SectionCta from './SectionCta.astro';
import { siteConfig, type Service } from '../config/site';
import { concretingSubservicePages, type ServicePageContent } from '../config/servicePageContent';
import { breadcrumbStructuredData, type BreadcrumbItem } from '../lib/structuredData';

interface Props {
  service: Service;
  content: ServicePageContent;
  projects: CollectionEntry<'projects'>[];
  breadcrumbs: BreadcrumbItem[];
  isTopLevel?: boolean;
}

const { service, content, projects, breadcrumbs, isTopLevel = false } = Astro.props;
const relatedServices = content.relatedServiceSlugs
  .map((slug) => siteConfig.services.find((item) => item.slug === slug))
  .filter((item): item is Service => Boolean(item));
const image = content.image ?? service.image;
const imageAlt = content.imageAlt ?? service.imageAlt;
const imageWidth = content.imageWidth ?? service.imageWidth;
const imageHeight = content.imageHeight ?? service.imageHeight;
const imageWidths = content.image ? undefined : ('imageWidths' in service ? service.imageWidths : undefined);
const socialImageWidth = imageWidths?.at(-1) ?? 1200;
---

<BaseLayout
  title={content.title}
  description={content.description}
  image={`${image}-${socialImageWidth}.webp`}
  imageAlt={imageAlt}
  structuredData={breadcrumbStructuredData(breadcrumbs)}
>
  <PageHero
    eyebrow={content.eyebrow}
    title={content.h1}
    intro={content.intro}
    visual="services"
    compact
  />

  <nav class="breadcrumb-bar" aria-label="Breadcrumb">
    <div class="container">
      {breadcrumbs.map((item, index) => (
        <>
          {index > 0 && <span aria-hidden="true">/</span>}
          {index === breadcrumbs.length - 1 ? <span aria-current="page">{item.name}</span> : <a href={item.path}>{item.name}</a>}
        </>
      ))}
    </div>
  </nav>

  <section class="section service-overview">
    <div class="container overview-grid">
      <div class="overview-media" data-reveal>
        <ResponsiveImage
          src={image}
          alt={imageAlt}
          width={imageWidth}
          height={imageHeight}
          widths={imageWidths}
          sizes="(min-width: 64rem) 50vw, 100vw"
        />
      </div>
      <div class="overview-copy" data-reveal>
        <p class="eyebrow">What Geli provides</p>
        <h2 class="display">{content.overviewHeading}</h2>
        {content.overview.map((paragraph) => <p>{paragraph}</p>)}
        <ul>
          {content.applications.map((application) => <li><Check size={17} aria-hidden="true" /> {application}</li>)}
        </ul>
        <div class="overview-actions">
          <a class="button" href={`/contact/?service=${service.formValue}#quote-form`}>Request a quote <ArrowRight size={18} aria-hidden="true" /></a>
          <a class="phone-action" href={siteConfig.phoneHref}><Phone size={17} aria-hidden="true" /> {siteConfig.phoneDisplay}</a>
        </div>
      </div>
    </div>
  </section>

  {isTopLevel && service.slug === 'concreting' && (
    <section class="section subservices-section">
      <div class="container">
        <div class="section-heading" data-reveal>
          <p class="eyebrow">Concrete project types</p>
          <h2 class="display">Explore proven concreting work</h2>
          <p>These dedicated pages are supported by genuine Geli project photography and descriptions.</p>
        </div>
        <div class="link-card-grid">
          {concretingSubservicePages.map((page) => (
            <a class="link-card" href={`/services/concreting/${page.slug}/`} data-reveal>
              <span>{page.eyebrow}</span>
              <strong>{page.h1}</strong>
              <small>View service <ArrowRight size={16} aria-hidden="true" /></small>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section process-section">
    <div class="container process-layout">
      <div data-reveal>
        <p class="eyebrow">How the work is planned</p>
        <h2 class="display">{content.processHeading}</h2>
      </div>
      <div class="process-list">
        {content.process.map((step, index) => (
          <article data-reveal style={`--stagger: ${index * 60}ms`}>
            <span>0{index + 1}</span>
            <div><h3>{step.title}</h3><p>{step.copy}</p></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section considerations-section">
    <div class="container">
      <div class="section-heading" data-reveal>
        <p class="eyebrow">Project details</p>
        <h2 class="display">{content.considerationsHeading}</h2>
      </div>
      <div class="considerations-grid">
        {content.considerations.map((item) => (
          <article data-reveal><h3>{item.title}</h3><p>{item.copy}</p></article>
        ))}
      </div>
    </div>
  </section>

  {projects.length > 0 && (
    <section class="section related-projects">
      <div class="container">
        <div class="section-heading related-heading" data-reveal>
          <div><p class="eyebrow">Genuine project examples</p><h2 class="display">Related Geli work</h2></div>
          <a class="text-link" href="/projects/">View all projects <ArrowRight size={18} aria-hidden="true" /></a>
        </div>
        <div class="project-grid">{projects.map((project) => <ProjectCard project={project} />)}</div>
      </div>
    </section>
  )}

  <section class="section related-links">
    <div class="container related-layout">
      <div data-reveal>
        <p class="eyebrow">Related services</p>
        <h2 class="display">Plan the complete outdoor project</h2>
      </div>
      <div class="related-service-links" data-reveal>
        {relatedServices.map((item) => <a href={`/services/${item.slug}/`}>{item.name}<ArrowRight size={17} aria-hidden="true" /></a>)}
        <a href="/areas-we-service/">Areas We Service<ArrowRight size={17} aria-hidden="true" /></a>
      </div>
    </div>
  </section>

  <SectionCta
    title={`Planning ${content.eyebrow.toLowerCase()}?`}
    copy={`Tell Geli Construction Services about the site, the work you need and the project location. We’ll discuss the scope and next step with you.`}
  />
</BaseLayout>

<style>
  .breadcrumb-bar { border-bottom: 1px solid var(--line); background: var(--paper); }
  .breadcrumb-bar .container { display: flex; flex-wrap: wrap; gap: .45rem; padding-block: .85rem; color: var(--muted); font-size: .68rem; }
  .breadcrumb-bar a:hover { color: var(--brand-primary-strong); }
  .service-overview { background: var(--paper); }
  .overview-grid { display: grid; align-items: center; gap: clamp(2.5rem, 7vw, 7rem); }
  .overview-media { min-width: 0; overflow: hidden; aspect-ratio: 4 / 3; background: var(--brand-light); box-shadow: var(--shadow); }
  .overview-media :global(picture), .overview-media :global(img) { width: 100%; height: 100%; }
  .overview-media :global(img) { object-fit: cover; }
  .overview-copy .display { max-width: 13ch; font-size: clamp(2.65rem, 5.6vw, 5.3rem); }
  .overview-copy > p:not(.eyebrow) { margin: 1rem 0 0; color: var(--muted); }
  .overview-copy > p:nth-of-type(2) { color: var(--brand-dark); font-size: clamp(1rem, 1.8vw, 1.15rem); }
  .overview-copy ul { display: grid; gap: .55rem; margin: 1.5rem 0 2rem; padding: 0; list-style: none; }
  .overview-copy li { display: flex; align-items: flex-start; gap: .65rem; color: var(--muted); font-size: .82rem; }
  .overview-copy li svg { flex: 0 0 auto; margin-top: .2rem; color: var(--brand-primary-strong); }
  .overview-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; }
  .phone-action { display: inline-flex; align-items: center; gap: .45rem; color: var(--brand-primary-strong); font-size: .73rem; font-weight: 800; }
  .subservices-section { background: var(--brand-light); }
  .section-heading { max-width: 56rem; margin-bottom: 2.5rem; }
  .section-heading .display { max-width: 14ch; font-size: clamp(2.7rem, 5.8vw, 5.5rem); }
  .section-heading > p:last-child { color: var(--muted); }
  .link-card-grid { display: grid; gap: 1rem; }
  .link-card { display: grid; min-height: 16rem; align-content: space-between; border-top: 3px solid var(--brand-primary); padding: 1.5rem; background: var(--paper); box-shadow: var(--shadow-soft); }
  .link-card > span { color: var(--brand-primary-strong); font-size: .68rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .link-card strong { font-family: "Archivo Variable", sans-serif; font-size: clamp(1.35rem, 2.5vw, 2rem); line-height: 1.05; text-transform: uppercase; }
  .link-card small { display: flex; align-items: center; gap: .4rem; font-size: .68rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  .process-section { background: var(--brand-dark); color: white; }
  .process-layout { display: grid; gap: clamp(2.5rem, 7vw, 7rem); }
  .process-section .eyebrow { color: var(--brand-primary); }
  .process-section .display { max-width: 12ch; font-size: clamp(2.7rem, 5.8vw, 5.5rem); }
  .process-list { border-top: 1px solid rgba(255,255,255,.18); }
  .process-list article { display: grid; grid-template-columns: 2.5rem 1fr; gap: 1rem; border-bottom: 1px solid rgba(255,255,255,.18); padding: 1.5rem 0; transition-delay: var(--stagger); }
  .process-list article > span { color: var(--brand-primary); font-size: .65rem; font-weight: 800; }
  .process-list h3 { margin: 0; font-family: "Archivo Variable", sans-serif; font-size: 1.15rem; text-transform: uppercase; }
  .process-list p { margin: .55rem 0 0; color: rgba(255,255,255,.65); font-size: .82rem; }
  .considerations-section { background: var(--brand-light); }
  .considerations-grid { display: grid; gap: 1rem; }
  .considerations-grid article { border: 1px solid var(--line); padding: 1.5rem; background: var(--paper); }
  .considerations-grid h3 { margin: 0; font-family: "Archivo Variable", sans-serif; font-size: 1.2rem; text-transform: uppercase; }
  .considerations-grid p { margin: .75rem 0 0; color: var(--muted); font-size: .82rem; }
  .related-projects { background: var(--paper); }
  .related-heading { display: flex; max-width: none; flex-direction: column; gap: 1rem; }
  .text-link { display: inline-flex; width: fit-content; align-items: center; gap: .45rem; color: var(--brand-primary-strong); font-size: .72rem; font-weight: 800; letter-spacing: .075em; text-transform: uppercase; }
  .project-grid { display: grid; gap: 3rem 1.5rem; }
  .related-links { background: var(--paper); }
  .related-layout { display: grid; gap: 2rem; }
  .related-links .display { max-width: 12ch; font-size: clamp(2.7rem, 5.8vw, 5.4rem); }
  .related-service-links { display: grid; border-top: 1px solid var(--line); }
  .related-service-links a { display: flex; align-items: center; justify-content: space-between; gap: 1rem; border-bottom: 1px solid var(--line); padding: 1rem .25rem; font-family: "Archivo Variable", sans-serif; font-size: .86rem; font-weight: 720; text-transform: uppercase; }
  .related-service-links a:hover { color: var(--brand-primary-strong); }
  @media (min-width: 48rem) { .link-card-grid, .considerations-grid { grid-template-columns: repeat(3, 1fr); } .project-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 64rem) { .overview-grid, .process-layout, .related-layout { grid-template-columns: 1fr 1fr; } .related-heading { flex-direction: row; align-items: flex-end; justify-content: space-between; } }
</style>
