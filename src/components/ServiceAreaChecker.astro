---
import { ArrowRight, ChevronDown, MapPin, Search } from '@lucide/astro';
import 'leaflet/dist/leaflet.css';
import { serviceAreaGroups } from '../config/serviceAreas';
---

<section class="service-area-section" data-service-area>
  <div class="container service-area-grid">
    <div class="service-map-shell" data-reveal>
      <div
        class="service-map"
        data-service-map
        role="img"
        aria-label="Interactive map showing the usual Geli Construction Services service locations"
      ></div>
      <div class="map-loading" data-map-loading>Loading service locations…</div>
      <div class="map-key" aria-hidden="true">
        <span><i class="area-swatch"></i> Usual service locations</span>
        <span><i class="selected-swatch"></i> Selected location</span>
      </div>
    </div>

    <div class="area-copy" data-reveal>
      <p class="eyebrow">Service area</p>
      <h2 class="display">Check if we service your suburb.</h2>
      <p class="area-lead">Our usual service area covers selected suburbs across South-East Melbourne, the Dandenong Ranges, Gippsland, Bass Coast, South Gippsland and the Latrobe Valley.</p>
      <p class="area-support">Start typing your suburb or postcode. If your location is outside our usual area, send us the project details anyway and we'll let you know if travel is possible.</p>

      <div class="location-checker" data-location-checker>
        <div class="checker-row">
          <div class="location-field" data-location-field>
            <label for="service-suburb">Your suburb or postcode</label>
            <div class="input-wrap">
              <Search size={18} stroke-width={1.8} aria-hidden="true" />
              <input
                id="service-suburb"
                type="text"
                inputmode="search"
                autocomplete="off"
                role="combobox"
                aria-autocomplete="list"
                aria-expanded="false"
                aria-controls="suburb-suggestions"
                placeholder="Start typing a Victorian suburb"
                data-location-input
              />
              <ul id="suburb-suggestions" class="suggestions" role="listbox" data-suggestions hidden></ul>
            </div>
          </div>
          <button class="checker-toggle" type="button" data-checker-toggle>
            <span>Check suburb</span><ArrowRight size={18} aria-hidden="true" />
          </button>
        </div>
        <div class="checker-result" data-checker-result aria-live="polite" hidden></div>
      </div>

      <p class="area-note"><MapPin size={16} stroke-width={1.8} aria-hidden="true" /> This checker is a practical guide. Final travel and job availability are confirmed when you request a quote.</p>
    </div>
  </div>

  <div class="container service-list-wrap" data-reveal>
    <button class="service-list-toggle" type="button" aria-expanded="false" aria-controls="service-area-list" data-service-list-toggle>
      <span>View all service areas</span><ChevronDown size={19} aria-hidden="true" />
    </button>
    <div class="service-list-panel" id="service-area-list" data-service-list-panel hidden>
      <div class="service-list-grid">
        {serviceAreaGroups.map((group) => (
          <section>
            <h3>{group.name}</h3>
            <ul>{group.suburbs.map((suburb) => <li>{suburb}</li>)}</ul>
          </section>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { servicedSuburbNames } from '../config/serviceAreas';
  import {
    createLocalityAutocomplete,
    findExactLocality,
    getVictorianLocalities,
    normaliseLocality,
    titleCaseLocality,
    type LocalityTuple,
  } from '../lib/localities';

  type MapState = {
    L: typeof import('leaflet');
    map: import('leaflet').Map;
    selectedMarker?: import('leaflet').CircleMarker;
  };

  const section = document.querySelector<HTMLElement>('[data-service-area]');
  const toggle = section?.querySelector<HTMLButtonElement>('[data-checker-toggle]');
  const input = section?.querySelector<HTMLInputElement>('[data-location-input]');
  const suggestions = section?.querySelector<HTMLUListElement>('[data-suggestions]');
  const result = section?.querySelector<HTMLElement>('[data-checker-result]');
  const mapElement = section?.querySelector<HTMLElement>('[data-service-map]');
  const mapLoading = section?.querySelector<HTMLElement>('[data-map-loading]');
  const listToggle = section?.querySelector<HTMLButtonElement>('[data-service-list-toggle]');
  const listPanel = section?.querySelector<HTMLElement>('[data-service-list-panel]');
  const serviced = new Set(servicedSuburbNames.map((name) => name.toLocaleUpperCase('en-AU')));

  let localities: LocalityTuple[] = [];
  let mapInstance: MapState | undefined;

  const isCovered = (suburb: string) => serviced.has(normaliseLocality(suburb));

  async function initialiseMap(): Promise<MapState | undefined> {
    if (!mapElement) return undefined;
    const leaflet = await import('leaflet');
    const L = (leaflet as unknown as { default: typeof import('leaflet') }).default;
    const data = localities.length ? localities : await getVictorianLocalities();
    localities = data;
    const serviceLocalities = data.filter(([suburb]) => isCovered(suburb));
    const map = L.map(mapElement, { attributionControl: true, scrollWheelZoom: false, zoomControl: true });

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; OpenStreetMap contributors',
      maxZoom: 18,
    }).addTo(map);

    const bounds = L.latLngBounds([]);
    serviceLocalities.forEach(([suburb, postcode, latitude, longitude]) => {
      bounds.extend([latitude, longitude]);
      L.circleMarker([latitude, longitude], {
        color: '#171615', fillColor: '#fca40c', fillOpacity: .86, radius: 4, weight: 1,
      }).bindTooltip(`${titleCaseLocality(suburb)} ${postcode}`, { direction: 'top' }).addTo(map);
    });
    map.fitBounds(bounds, { padding: [24, 24], maxZoom: 9 });
    mapLoading?.remove();
    return { L, map };
  }

  const loadMap = () => {
    if (mapInstance || !mapElement) return;
    initialiseMap()
      .then((instance) => { mapInstance = instance; })
      .catch((error) => {
        console.error('Service map failed to initialise.', error);
        if (mapLoading) mapLoading.textContent = 'The map is temporarily unavailable. The suburb checker still works.';
      });
  };

  if (section && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      loadMap();
      getVictorianLocalities().then((data) => { localities = data; }).catch(() => {});
      observer.disconnect();
    }, { rootMargin: '300px' });
    observer.observe(section);
  } else loadMap();

  const showCoverage = async (locality: LocalityTuple) => {
    if (!result) return;
    const [suburb, postcode, latitude, longitude] = locality;
    const place = `${titleCaseLocality(suburb)} ${postcode}`;
    const covered = isCovered(suburb);
    result.hidden = false;
    result.className = `checker-result ${covered ? 'is-covered' : 'is-outside'}`;
    result.innerHTML = covered
      ? `<strong>Great news—we service ${place}.</strong><span>Your suburb is within our usual service area.</span><a href="/contact/?location=${encodeURIComponent(place)}#quote-form">Request a quote <span aria-hidden="true">→</span></a>`
      : `<strong>${place} is outside our usual area.</strong><span>Send us the project details anyway and we’ll let you know if we can make the travel work.</span><a href="/contact/?location=${encodeURIComponent(place)}#quote-form">Ask about your project <span aria-hidden="true">→</span></a>`;

    const instance = mapInstance ?? await initialiseMap().catch(() => undefined);
    if (!mapInstance) mapInstance = instance;
    if (!instance) return;
    instance.selectedMarker?.remove();
    instance.selectedMarker = instance.L.circleMarker([latitude, longitude], {
      color: '#ffffff', fillColor: covered ? '#c76c06' : '#9f2f26', fillOpacity: 1, radius: 9, weight: 3,
    }).bindTooltip(place, { direction: 'top', permanent: true }).addTo(instance.map);
    instance.map.flyTo([latitude, longitude], covered ? 11 : 9, { animate: !window.matchMedia('(prefers-reduced-motion: reduce)').matches, duration: 1 });
  };

  const autocomplete = input && suggestions
    ? createLocalityAutocomplete({
      input,
      suggestions,
      optionIdPrefix: 'suburb-option',
      onSelect: showCoverage,
    })
    : undefined;

  const checkCurrentValue = () => {
    if (!input || !result) return;
    const exact = findExactLocality(localities, input.value, input.dataset.selectedLocality);
    if (exact) return autocomplete?.select(exact);
    result.hidden = false;
    result.className = 'checker-result is-unknown';
    result.innerHTML = '<strong>We could not match that location.</strong><span>Choose a suggestion, or try a Victorian suburb name or four-digit postcode.</span>';
  };

  toggle?.addEventListener('click', async () => {
    if (!localities.length) localities = await getVictorianLocalities().catch(() => []);
    checkCurrentValue();
  });

  listToggle?.addEventListener('click', () => {
    if (!listPanel || !listToggle) return;
    const opening = listToggle.getAttribute('aria-expanded') !== 'true';
    listToggle.setAttribute('aria-expanded', String(opening));
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      listPanel.hidden = !opening;
      return;
    }
    if (opening) {
      listPanel.hidden = false;
      listPanel.animate([{ height: '0', opacity: 0 }, { height: `${listPanel.scrollHeight}px`, opacity: 1 }], { duration: 480, easing: 'cubic-bezier(.2,.7,.2,1)' });
    } else {
      const animation = listPanel.animate([{ height: `${listPanel.offsetHeight}px`, opacity: 1 }, { height: '0', opacity: 0 }], { duration: 380, easing: 'cubic-bezier(.2,.7,.2,1)' });
      animation.addEventListener('finish', () => { listPanel.hidden = true; }, { once: true });
    }
  });
</script>

<style>
  .service-area-section { overflow: hidden; padding-block: clamp(4.75rem, 9vw, 8.5rem); background: var(--paper); }
  .service-area-grid { display: grid; align-items: center; gap: clamp(3rem, 7vw, 7rem); }
  .service-map-shell { position: relative; min-width: 0; overflow: hidden; border: 1px solid var(--line); background: #e8e3d8; box-shadow: var(--shadow); }
  .service-map { z-index: 0; width: 100%; min-height: 31rem; }
  .map-loading { position: absolute; inset: 0; z-index: 1; display: grid; place-items: center; background: var(--brand-light); color: var(--muted); font-size: .76rem; }
  .map-key { position: absolute; right: .75rem; bottom: .75rem; z-index: 500; display: flex; flex-wrap: wrap; gap: .55rem 1rem; max-width: calc(100% - 1.5rem); padding: .7rem .8rem; background: rgba(250,248,244,.95); box-shadow: 0 8px 22px rgba(23,22,21,.12); color: var(--muted); font-size: .62rem; backdrop-filter: blur(8px); }
  .map-key span { display: flex; align-items: center; gap: .4rem; }
  .map-key i { display: block; width: .7rem; height: .7rem; border-radius: 50%; }
  .area-swatch { border: 1px solid var(--brand-dark); background: var(--brand-primary); }
  .selected-swatch { border: 2px solid white; background: var(--brand-primary-strong); box-shadow: 0 0 0 1px var(--brand-dark); }
  .area-copy .display { max-width: 13ch; font-size: clamp(2.8rem, 5.6vw, 5.2rem); }
  .area-lead { margin: 1.25rem 0 0; font-size: clamp(1rem, 2vw, 1.2rem); }
  .area-support { max-width: 40rem; margin: .75rem 0 0; color: var(--muted); font-size: .86rem; }
  .location-checker { margin-top: 1.7rem; }
  .checker-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: .75rem; }
  .location-field { min-width: 0; }
  .location-field label { display: block; margin: 0 0 .45rem; font-family: "Archivo Variable", sans-serif; font-size: .66rem; font-weight: 760; letter-spacing: .08em; text-transform: uppercase; }
  .input-wrap { position: relative; }
  .input-wrap > svg { position: absolute; top: 50%; left: .9rem; z-index: 1; color: var(--brand-primary-strong); pointer-events: none; transform: translateY(-50%); }
  .input-wrap input { width: 100%; min-height: 3.35rem; border: 1px solid var(--line); border-radius: .2rem; padding: .8rem 1rem .8rem 2.75rem; background: white; color: var(--brand-dark); }
  .input-wrap input:focus { border-color: var(--brand-primary-strong); outline: 0; box-shadow: 0 0 0 3px rgba(252,164,12,.2); }
  .suggestions { position: absolute; top: calc(100% + .35rem); right: 0; left: 0; z-index: 700; max-height: 18rem; overflow-y: auto; border: 1px solid var(--line); margin: 0; padding: .35rem; background: white; box-shadow: var(--shadow); list-style: none; }
  .suggestions[hidden] { display: none; }
  .suggestions li { padding: .7rem .75rem; color: var(--muted); font-size: .78rem; cursor: pointer; }
  .suggestions li:hover, .suggestions li[aria-selected="true"] { background: var(--brand-light); color: var(--brand-dark); }
  .checker-toggle { display: inline-flex; min-height: 3.35rem; align-items: center; justify-content: center; gap: .5rem; border: 1px solid var(--brand-primary-strong); padding: .75rem 1rem; background: var(--brand-primary); color: var(--brand-dark); font-family: "Archivo Variable", sans-serif; font-size: .7rem; font-weight: 800; letter-spacing: .075em; text-transform: uppercase; white-space: nowrap; cursor: pointer; transition: transform .2s ease, background .2s ease; }
  .checker-toggle:hover { background: var(--brand-primary-soft); transform: translateY(-2px); }
  .checker-result { display: grid; gap: .25rem; border-left: 3px solid var(--brand-primary-strong); margin-top: 1rem; padding: .9rem 1rem; background: var(--brand-light); animation: result-in .38s cubic-bezier(.2,.7,.2,1); }
  .checker-result[hidden] { display: none; }
  .checker-result.is-outside { border-left-color: #9f2f26; }
  .checker-result strong { font-family: "Archivo Variable", sans-serif; font-size: .85rem; }
  .checker-result span { color: var(--muted); font-size: .75rem; }
  .checker-result a { margin-top: .4rem; color: var(--brand-primary-strong); font-size: .68rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; }
  .area-note { display: flex; align-items: flex-start; gap: .55rem; max-width: 40rem; margin: 1.25rem 0 0; color: var(--muted); font-size: .69rem; }
  .area-note svg { flex: 0 0 auto; margin-top: .15rem; color: var(--brand-primary-strong); }
  .service-list-wrap { margin-top: clamp(2.5rem, 6vw, 5rem); }
  .service-list-toggle { display: flex; width: 100%; align-items: center; justify-content: space-between; border: 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 1.15rem .25rem; background: transparent; color: var(--brand-dark); font-family: "Archivo Variable", sans-serif; font-size: .76rem; font-weight: 780; letter-spacing: .09em; text-transform: uppercase; cursor: pointer; }
  .service-list-toggle svg { color: var(--brand-primary-strong); transition: transform .25s ease; }
  .service-list-toggle[aria-expanded="true"] svg { transform: rotate(180deg); }
  .service-list-panel { overflow: hidden; }
  .service-list-grid { display: grid; gap: 2rem; padding: 2.5rem 0 1rem; }
  .service-list-grid h3 { margin: 0 0 .85rem; font-family: "Archivo Variable", sans-serif; font-size: 1rem; text-transform: uppercase; }
  .service-list-grid ul { columns: 2; gap: 1rem; margin: 0; padding: 0; list-style: none; }
  .service-list-grid li { break-inside: avoid; margin-bottom: .35rem; color: var(--muted); font-size: .73rem; }
  :global(.leaflet-container) { background: #e8e3d8; font-family: "Manrope Variable", sans-serif; }
  :global(.leaflet-control-zoom a) { color: var(--brand-dark); }
  :global(.leaflet-tooltip) { border: 0; border-radius: .15rem; padding: .45rem .6rem; background: var(--brand-dark); box-shadow: none; color: white; font-size: .66rem; }
  :global(.leaflet-tooltip-top::before) { border-top-color: var(--brand-dark); }
  :global(.leaflet-control-attribution) { max-width: 80%; font-size: 8px; }
  @keyframes result-in { from { opacity: 0; transform: translateY(.5rem); } }
  @media (min-width: 48rem) { .service-list-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 64rem) { .service-area-grid { grid-template-columns: 1fr 1fr; } .service-list-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 39rem) { .service-map { min-height: 23rem; } .checker-row { grid-template-columns: 1fr; } .suggestions { position: static; margin-top: .35rem; } .checker-toggle { width: 100%; } .service-list-grid ul { columns: 1; } }
  @media (prefers-reduced-motion: reduce) { .service-list-toggle svg { transition: none; } }
</style>
