---
import { ArrowUpRight } from '@lucide/astro';
import type { CollectionEntry } from 'astro:content';
import ResponsiveImage from './ResponsiveImage.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  priority?: boolean;
}

const { project, priority = false } = Astro.props;
---

<article class="project-card" data-category={project.data.categories.join('|')} data-reveal>
  <a class="project-image" href={`/projects/${project.data.slug}/`} aria-label={`View ${project.data.title}`}>
    <ResponsiveImage
      src={project.data.coverImage}
      alt={project.data.coverAlt}
      width={project.data.coverWidth}
      height={project.data.coverHeight}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      sizes="(min-width: 1024px) 50vw, 100vw"
    />
  </a>
  <div class="project-meta">
    <p>{project.data.categories.join(' · ')}</p>
    {project.data.tags.length > 0 && <p>{project.data.tags.join(' · ')}</p>}
  </div>
  <h3><a href={`/projects/${project.data.slug}/`}>{project.data.title}</a></h3>
  <a class="project-link" href={`/projects/${project.data.slug}/`}>View project <ArrowUpRight size={18} aria-hidden="true" /></a>
</article>

<style>
  .project-card { min-width: 0; }
  .project-card[hidden] { display: none; }
  .project-image { position: relative; display: block; overflow: hidden; aspect-ratio: 4 / 3; background: var(--brand-muted-light); }
  .project-image :global(picture), .project-image :global(img) { width: 100%; height: 100%; }
  .project-image :global(img) { object-fit: cover; transition: transform .55s cubic-bezier(.2,.7,.2,1); }
  .project-card:hover .project-image :global(img) { transform: scale(1.035); }
  .project-meta { display: flex; justify-content: space-between; gap: 1rem; margin-top: 1rem; }
  .project-meta p { margin: 0; color: var(--muted); font-size: .65rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .project-card h3 { margin: .5rem 0 .8rem; font-family: "Archivo Variable", sans-serif; font-size: clamp(1.35rem, 2.6vw, 2rem); font-weight: 700; letter-spacing: -.035em; line-height: 1.08; }
  .project-link { display: inline-flex; align-items: center; gap: .45rem; color: var(--brand-primary-strong); font-size: .73rem; font-weight: 800; letter-spacing: .07em; text-transform: uppercase; }
  .project-link svg { transition: transform .2s ease; }
  .project-link:hover svg { transform: translate(.15rem,-.15rem); }
  @media (prefers-reduced-motion: reduce) { .project-image :global(img), .project-link svg { transition: none; } }
</style>
