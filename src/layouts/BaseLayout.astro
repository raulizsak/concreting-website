---
import '@fontsource-variable/manrope';
import '@fontsource-variable/archivo';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import RevealObserver from '../components/RevealObserver.astro';
import { siteConfig } from '../config/site';
import { servicedSuburbNames } from '../config/serviceAreas';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  image = '/og.png',
  imageAlt = 'Geli Construction Services — Concreting and Outdoor Construction',
  noindex = false,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  name: siteConfig.businessName,
  url: siteConfig.domain,
  telephone: '+61494802784',
  email: siteConfig.emailDisplay,
  taxID: `ABN ${siteConfig.abn}`,
  logo: `${siteConfig.domain}/logo/geli-construction-services-logo.jpeg`,
  image: `${siteConfig.domain}/og.png`,
  description: siteConfig.description,
  sameAs: Object.values(siteConfig.socials),
  areaServed: servicedSuburbNames.map((name) => ({ '@type': 'City', name })),
  makesOffer: siteConfig.services.map((service) => ({
    '@type': 'Offer',
    itemOffered: { '@type': 'Service', name: service.name, description: service.summary },
  })),
};
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#171615" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:site_name" content={siteConfig.businessName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <div class="mobile-contact" aria-label="Quick contact">
      <a href={siteConfig.phoneHref}>Call now</a>
      <a href="/contact/#quote-form">Get a quote</a>
    </div>
    <RevealObserver />
  </body>
</html>

<style>
  .mobile-contact { position: fixed; inset: auto 0 0; z-index: 45; display: grid; grid-template-columns: 1fr 1.25fr; padding-bottom: env(safe-area-inset-bottom); background: var(--brand-dark); box-shadow: 0 -8px 28px rgba(0,0,0,.18); }
  .mobile-contact a { display: grid; min-height: 4.25rem; place-items: center; border-top: 1px solid rgba(255,255,255,.16); color: white; font-family: "Archivo Variable", sans-serif; font-size: .76rem; font-weight: 760; letter-spacing: .09em; text-transform: uppercase; }
  .mobile-contact a + a { background: var(--brand-primary); color: var(--brand-dark); }
  @media (min-width: 48rem) { .mobile-contact { display: none; } }
</style>
