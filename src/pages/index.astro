---
import { ArrowDown, ArrowRight, ArrowUpRight, BrickWall, Droplets, Layers, PanelsTopLeft, Phone, Shovel, Sprout } from '@lucide/astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import SectionCta from '../components/SectionCta.astro';
import ServiceAreaChecker from '../components/ServiceAreaChecker.astro';
import { siteConfig } from '../config/site';

const projects = (await getCollection('projects'))
  .filter((project) => project.data.featured)
  .sort((a, b) => b.data.order - a.data.order);
const serviceIcons = [Layers, Shovel, PanelsTopLeft, Sprout, Droplets, BrickWall];
const reasons = [
  {
    title: 'Multiple outdoor services',
    copy: 'Concrete, stonework, excavation, retaining walls, drainage and outdoor finishing can be discussed as part of the same project.',
  },
  {
    title: 'Concrete finish options',
    copy: 'Choose from plain concrete, coloured concrete and exposed aggregate depending on the job and the finish you want.',
  },
  {
    title: 'Broad service area',
    copy: 'Servicing selected suburbs across South-East Melbourne, the Dandenong Ranges, Gippsland, Bass Coast, South Gippsland and the Latrobe Valley.',
  },
  {
    title: 'Straightforward quote requests',
    copy: 'Tell us what you need, where the project is and a few details about the job so we can discuss the scope and next steps.',
  },
];
---

<BaseLayout
  title="Geli Construction Services | Concreting & Outdoor Construction"
  description="Concreting, excavation, stonework, retaining walls, drainage and outdoor finishing across South-East Melbourne, Gippsland and surrounding service areas."
>
  <section class="hero">
    <ResponsiveImage
      class="hero-picture"
      src="/images/hero/hero"
      alt=""
      variant="hero"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero-backdrop" aria-hidden="true"></div>
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="hero-inner container">
      <div class="hero-copy">
        <p class="hero-kicker">Concreting <span>•</span> Stonework <span>•</span> Outdoor construction</p>
        <h1 class="display">Concreting <em>&amp;</em><br />outdoor construction</h1>
        <p class="hero-lead">Driveways, footpaths, alfresco areas, steps, stonework, retaining walls, excavation, drainage and outdoor finishing across South-East Melbourne, the Dandenong Ranges, Gippsland and surrounding areas.</p>
        <div class="hero-actions">
          <a class="button" href="/contact/">Get a free quote <ArrowUpRight size={18} aria-hidden="true" /></a>
          <a class="button button--outline" href={siteConfig.phoneHref}><Phone size={17} aria-hidden="true" /> Call {siteConfig.phoneDisplay}</a>
        </div>
      </div>
      <a class="hero-scroll" href="#introduction"><ArrowDown size={18} aria-hidden="true" /> Explore our work</a>
    </div>
  </section>

  <section class="section introduction" id="introduction">
    <div class="container intro-grid" data-reveal>
      <p class="eyebrow">Built for practical outdoor spaces</p>
      <div>
        <h2 class="display">From groundwork to the finished surface.</h2>
        <div class="intro-copy">
          <p>Geli Construction Services provides concreting and outdoor construction services for homes and outdoor spaces, from driveways and footpaths through to stonework, retaining walls, excavation, drainage and finishing touches.</p>
          <p>Whether you're planning a new driveway, footpath, alfresco area or a broader outdoor upgrade, tell us what you're working on and we can discuss the right approach for your site.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section services-section">
    <div class="container">
      <div class="section-heading" data-reveal>
        <div>
          <p class="eyebrow">What we do</p>
          <h2 class="display">Outdoor construction, connected.</h2>
        </div>
        <a class="text-link" href="/services/">Explore all services <ArrowRight size={18} aria-hidden="true" /></a>
      </div>
      <div class="services-grid">
        {siteConfig.services.map((service, index) => {
          const Icon = serviceIcons[index];
          return (
            <article class="service-card" data-reveal style={`--stagger: ${index * 55}ms`}>
              <div class="service-visual" aria-hidden="true">
                <span>0{index + 1}</span><Icon size={30} stroke-width={1.45} />
              </div>
              <div class="service-card-copy">
                <h3>{service.name}</h3>
                <p>{service.summary}</p>
                <a href={`/services/#${service.slug}`} aria-label={`Learn about ${service.name}`}>View service <ArrowUpRight size={17} aria-hidden="true" /></a>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section projects-section">
    <div class="container">
      <div class="section-heading" data-reveal>
        <div><p class="eyebrow">Recent work</p><h2 class="display">Concrete projects</h2></div>
        <a class="text-link" href="/projects/">View all projects <ArrowRight size={18} aria-hidden="true" /></a>
      </div>
      <div class="project-grid">{projects.map((project, index) => <ProjectCard project={project} priority={index === 0} />)}</div>
    </div>
  </section>

  <section class="section reasons-section">
    <div class="container reasons-layout">
      <div class="reasons-heading" data-reveal>
        <p class="eyebrow">Why choose Geli Construction Services</p>
        <h2 class="display">One team for the work around your property.</h2>
      </div>
      <div class="reasons-list">
        {reasons.map((reason, index) => (
          <article data-reveal style={`--stagger: ${index * 55}ms`}>
            <span>0{index + 1}</span>
            <div><h3>{reason.title}</h3><p>{reason.copy}</p></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="feedback-section">
    <div class="container feedback-card" data-reveal>
      <p class="eyebrow">Customer feedback</p>
      <h2 class="display">Reviews coming soon.</h2>
      <p>We're preparing this section for genuine customer feedback. Check back soon.</p>
    </div>
  </section>

  <ServiceAreaChecker />
  <SectionCta />
</BaseLayout>

<style>
  .hero { position: relative; min-height: min(58rem, 100svh); overflow: hidden; background: var(--brand-dark); color: white; }
  :global(.hero-picture), :global(.hero-picture img) { position: absolute; inset: 0; width: 100%; height: 100%; }
  :global(.hero-picture img) { object-fit: cover; object-position: 58% center; }
  .hero-backdrop { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(12,11,10,.9) 0%, rgba(12,11,10,.72) 46%, rgba(12,11,10,.18) 78%), linear-gradient(0deg, rgba(12,11,10,.6), transparent 45%); }
  .hero-grid { position: absolute; inset: 0 60% 0 0; border-right: 1px solid rgba(255,255,255,.14); background-image: linear-gradient(rgba(255,255,255,.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.1) 1px, transparent 1px); background-size: 5rem 5rem; opacity: .35; }
  .hero-inner { position: relative; z-index: 1; display: flex; min-height: min(58rem, 100svh); flex-direction: column; justify-content: center; padding-top: 7rem; padding-bottom: 3rem; }
  .hero-copy { max-width: 59rem; animation: hero-copy-in .65s cubic-bezier(.2,.7,.2,1) both .08s; }
  .hero-kicker { margin: 0 0 1.25rem; color: var(--brand-primary); font-family: "Archivo Variable", sans-serif; font-size: clamp(.62rem, 1.5vw, .76rem); font-weight: 720; letter-spacing: .12em; text-transform: uppercase; }
  .hero-kicker span { padding-inline: .25rem; }
  .hero .display { max-width: 12ch; font-size: clamp(3.25rem, 8.4vw, 8.2rem); }
  .hero .display em { color: var(--brand-primary); font-style: normal; }
  .hero-lead { max-width: 49rem; margin: 1.5rem 0 0; color: rgba(255,255,255,.76); font-size: clamp(1rem, 2vw, 1.2rem); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  .hero-scroll { position: absolute; bottom: 2rem; display: none; align-items: center; gap: .55rem; color: rgba(255,255,255,.7); font-size: .68rem; font-weight: 720; letter-spacing: .08em; text-transform: uppercase; }
  .introduction { background: var(--paper); }
  .intro-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 2rem; }
  .intro-grid > * { min-width: 0; }
  .intro-grid .display { max-width: 15ch; font-size: clamp(2.8rem, 6.5vw, 6.2rem); }
  .intro-copy { display: grid; gap: 1rem; max-width: 52rem; margin-top: 1.75rem; }
  .intro-copy p { margin: 0; color: var(--muted); }
  .services-section { background: var(--brand-light); }
  .section-heading { display: flex; flex-direction: column; gap: 1.5rem; margin-bottom: clamp(2.5rem, 5vw, 4.5rem); }
  .section-heading .display { max-width: 14ch; font-size: clamp(2.8rem, 6vw, 5.7rem); }
  .text-link { display: inline-flex; width: fit-content; align-items: center; gap: .5rem; color: var(--brand-primary-strong); font-size: .72rem; font-weight: 800; letter-spacing: .075em; text-transform: uppercase; }
  .services-grid { display: grid; gap: 1rem; }
  .service-card { display: grid; min-width: 0; border: 1px solid var(--line); background: var(--paper); transition: transform .25s ease, box-shadow .25s ease; transition-delay: var(--stagger, 0ms); }
  .service-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-soft); }
  .service-visual { position: relative; display: flex; min-height: 9rem; align-items: flex-end; justify-content: space-between; overflow: hidden; padding: 1.25rem; background: var(--brand-dark); color: var(--brand-primary); }
  .service-visual::before { position: absolute; inset: 0; opacity: .18; background-image: linear-gradient(rgba(255,255,255,.25) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.25) 1px, transparent 1px); background-size: 2.5rem 2.5rem; content: ""; }
  .service-visual::after { position: absolute; right: -3rem; bottom: -5rem; width: 10rem; height: 10rem; border: 1px solid rgba(252,164,12,.45); border-radius: 50%; content: ""; }
  .service-visual span, .service-visual svg { position: relative; z-index: 1; }
  .service-visual span { font-size: .66rem; font-weight: 800; letter-spacing: .1em; }
  .service-card-copy { display: flex; min-height: 15rem; flex-direction: column; padding: 1.35rem; }
  .service-card h3 { margin: 0; font-family: "Archivo Variable", sans-serif; font-size: 1.2rem; font-weight: 720; letter-spacing: -.025em; line-height: 1.15; text-transform: uppercase; }
  .service-card p { margin: .8rem 0 1.2rem; color: var(--muted); font-size: .78rem; }
  .service-card a { display: inline-flex; align-items: center; gap: .4rem; margin-top: auto; color: var(--brand-primary-strong); font-size: .66rem; font-weight: 800; letter-spacing: .07em; text-transform: uppercase; }
  .projects-section { background: var(--paper); }
  .project-grid { display: grid; gap: 3rem 1.5rem; }
  .reasons-section { background: var(--brand-dark); color: white; }
  .reasons-layout { display: grid; gap: clamp(3rem, 7vw, 7rem); }
  .reasons-heading { align-self: start; }
  .reasons-heading .eyebrow { color: var(--brand-primary); }
  .reasons-heading .display { max-width: 12ch; font-size: clamp(2.8rem, 6vw, 5.5rem); }
  .reasons-list { border-top: 1px solid rgba(255,255,255,.18); }
  .reasons-list article { display: grid; grid-template-columns: 2.5rem 1fr; gap: 1rem; border-bottom: 1px solid rgba(255,255,255,.18); padding: 1.5rem 0; transition-delay: var(--stagger, 0ms); }
  .reasons-list article > span { color: var(--brand-primary); font-size: .64rem; font-weight: 780; }
  .reasons-list h3 { margin: 0; font-family: "Archivo Variable", sans-serif; font-size: 1.1rem; text-transform: uppercase; }
  .reasons-list p { margin: .55rem 0 0; color: rgba(255,255,255,.62); font-size: .8rem; }
  .feedback-section { padding-block: clamp(4rem, 8vw, 7rem); background: var(--brand-primary); }
  .feedback-card { text-align: center; }
  .feedback-card .eyebrow { color: var(--brand-dark); }
  .feedback-card .display { font-size: clamp(3rem, 7vw, 6.5rem); }
  .feedback-card > p:last-child { max-width: 36rem; margin: 1.25rem auto 0; }
  @keyframes hero-copy-in { from { opacity: 0; transform: translateY(12px); } }
  @media (min-width: 48rem) { .hero-scroll { display: flex; } .services-grid { grid-template-columns: repeat(2, 1fr); } .project-grid { grid-template-columns: repeat(2, 1fr); } .project-grid :global(.project-card:last-child) { grid-column: 1 / -1; width: calc(50% - .75rem); } }
  @media (min-width: 64rem) { .intro-grid { grid-template-columns: .45fr 1.55fr; } .intro-copy { grid-template-columns: 1fr 1fr; } .section-heading { flex-direction: row; align-items: flex-end; justify-content: space-between; } .services-grid { grid-template-columns: repeat(3, 1fr); } .reasons-layout { grid-template-columns: .9fr 1.1fr; } .reasons-heading { position: sticky; top: 2rem; } }
  @media (max-width: 39rem) { .hero-actions .button { width: 100%; } :global(.hero-picture img) { object-position: 62% center; } }
  @media (prefers-reduced-motion: reduce) { .hero-copy { animation: none; } }
</style>
