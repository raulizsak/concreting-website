---
import { ArrowDown, ArrowRight, ArrowUpRight, Check, Phone, Quote } from '@lucide/astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import SectionCta from '../components/SectionCta.astro';
import { siteConfig } from '../config/site';

const projects = (await getCollection('projects'))
  .filter((project) => project.data.featured)
  .sort((a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0));

const serviceImages = ['/images/demo/driveway', '/images/demo/fence-charcoal', '/images/demo/backyard'];
const values = ['Quality workmanship', 'Clear communication', 'Reliable service', 'Free quotes'];
---

<BaseLayout
  title="Concreting, Fencing & Outdoor Works | Your Business Name"
  description="Quality outdoor work built for Australian homes. Request a free quote for concreting, fencing and outdoor works."
>
  <section class="hero">
    <ResponsiveImage
      class="hero-picture"
      src="/images/demo/hero"
      alt="Generated demo image of a tradesperson inspecting an exposed aggregate driveway at an Australian home"
      variant="hero"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero-backdrop" aria-hidden="true"></div>
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="hero-inner container">
      <div class="hero-copy">
        <p class="hero-kicker"><span>Residential outdoor construction</span><span>Demo website</span></p>
        <h1 class="display">Concreting,<br />fencing <em>&amp;</em><br />outdoor works</h1>
        <p class="hero-lead">{siteConfig.tagline}</p>
        <div class="hero-actions">
          <a class="button" href="/contact/">Get a free quote <ArrowRight size={18} aria-hidden="true" /></a>
          <a class="button button--outline" href={siteConfig.phoneHref}><Phone size={17} aria-hidden="true" /> Call now</a>
        </div>
      </div>
      <a class="scroll-cue" href="#introduction">
        <span>Explore our work</span>
        <ArrowDown size={18} aria-hidden="true" />
      </a>
      <p class="hero-note">Original demo imagery · Not client project photography</p>
    </div>
  </section>

  <section class="section introduction" id="introduction">
    <div class="container intro-grid">
      <p class="eyebrow">Built around your home</p>
      <div>
        <h2 class="display">Practical outdoor work.<br /><span>Finished with care.</span></h2>
        <div class="intro-copy">
          <p>We help homeowners complete the spaces around their homes with considered concreting, fencing and general outdoor construction solutions.</p>
          <p class="demo-note">This introduction is demo copy and will be refined once the client's confirmed services and approach are supplied.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section services-home">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">What we can show</p>
          <h2 class="display">Outdoor work,<br />covered.</h2>
        </div>
        <p>The service list below is presentation content only. It is centralised and ready to refine when the client confirms the exact offering.</p>
      </div>

      <div class="service-grid">
        {siteConfig.services.map((service, index) => (
          <article class="service-card">
            <a class="service-image" href="/services/">
              <ResponsiveImage src={serviceImages[index]} alt={`Generated demo image representing ${service.name.toLowerCase()} work`} sizes="(min-width: 1024px) 33vw, 100vw" />
              <span>0{index + 1}</span>
            </a>
            <div class="service-body">
              <h3>{service.name}</h3>
              <p>{service.summary}</p>
              <ul>
                {service.examples.slice(0, 3).map((example) => <li>{example}</li>)}
              </ul>
              <a href="/services/">Explore service <ArrowUpRight size={18} aria-hidden="true" /></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section projects-home">
    <div class="container">
      <div class="section-heading section-heading--projects">
        <div>
          <p class="eyebrow">Selected demo work</p>
          <h2 class="display">Recent projects</h2>
        </div>
        <a class="text-link" href="/projects/">View all projects <ArrowRight size={18} aria-hidden="true" /></a>
      </div>
      <p class="project-disclaimer">All photography and project details in this section are generated sample content for the client presentation—not completed work by this business.</p>
      <div class="project-grid">
        {projects.slice(0, 6).map((project, index) => <ProjectCard project={project} priority={index < 2} />)}
      </div>
    </div>
  </section>

  <section class="section values-section">
    <div class="container values-grid">
      <div class="values-intro">
        <p class="eyebrow">Why choose us</p>
        <h2 class="display">A better experience,<br />from quote to finish.</h2>
        <p>These are editable demo value propositions. They should be reviewed with the client before any public launch.</p>
      </div>
      <div class="value-list">
        {values.map((value, index) => (
          <div class="value-row">
            <span>0{index + 1}</span>
            <h3>{value}</h3>
            <Check size={22} stroke-width={1.8} aria-hidden="true" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section testimonials-section">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Future customer stories</p>
          <h2 class="display">Reviews that build trust.</h2>
        </div>
        <p>This section is ready for genuine, approved reviews. The current cards are deliberately labelled as placeholders.</p>
      </div>
      <div class="testimonial-grid">
        {['Customer feedback about the finished work can sit here once a genuine review is supplied.', 'Use this space for a real customer comment about communication, reliability or the project result.', 'A third approved testimonial can be added here without changing the page design.'].map((quote) => (
          <article class="testimonial-card">
            <Quote size={30} stroke-width={1.5} aria-hidden="true" />
            <p class="sample-label">Sample testimonial</p>
            <blockquote>“{quote}”</blockquote>
            <p class="sample-person">Customer name · [Suburb]</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="service-area-section">
    <div class="container service-area-grid">
      <div class="area-visual" aria-hidden="true">
        <span></span><span></span><span></span>
        <strong>01</strong>
      </div>
      <div class="area-copy">
        <p class="eyebrow">Service area</p>
        <h2 class="display">Local work.<br />Clear coverage.</h2>
        <p>Serving <strong>[SERVICE AREA]</strong> and surrounding suburbs.</p>
        <p class="area-note">Placeholder only—no suburb or region is being claimed until the client confirms where the business operates.</p>
        <a class="text-link" href="/contact/">Check your location <ArrowRight size={18} aria-hidden="true" /></a>
      </div>
    </div>
  </section>

  <SectionCta />
</BaseLayout>

<style>
  .hero { position: relative; min-height: max(47rem, 100svh); overflow: hidden; background: #24251f; color: white; }
  :global(.hero-picture) { position: absolute; inset: 0; }
  :global(.hero-picture img) { width: 100%; height: 100%; object-fit: cover; object-position: 59% center; }
  .hero-backdrop { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(15,16,14,.98) 0%, rgba(15,16,14,.84) 38%, rgba(15,16,14,.26) 74%, rgba(15,16,14,.18) 100%), linear-gradient(0deg, rgba(15,16,14,.52), transparent 44%); }
  .hero-grid { position: absolute; inset: 0; opacity: .18; background-image: linear-gradient(rgba(255,255,255,.11) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.11) 1px, transparent 1px); background-size: 5rem 5rem; mask-image: linear-gradient(to right, transparent 20%, black); }
  .hero-inner { position: relative; display: grid; min-height: max(47rem, 100svh); align-content: center; padding-top: 8rem; padding-bottom: 7rem; }
  .hero-copy { position: relative; z-index: 1; width: 100%; min-width: 0; max-width: 60rem; }
  .hero-kicker { display: flex; flex-wrap: wrap; gap: .6rem 1.5rem; margin: 0 0 1.5rem; color: rgba(255,255,255,.7); font-family: "Archivo Variable", sans-serif; font-size: .67rem; font-weight: 650; letter-spacing: .12em; text-transform: uppercase; }
  .hero-kicker span + span { color: var(--amber); }
  .hero .display { max-width: 12ch; overflow-wrap: break-word; font-size: clamp(2.65rem, 12vw, 8.7rem); }
  .hero .display em { color: var(--amber); font-style: normal; }
  .hero-lead { max-width: 35rem; margin: 1.5rem 0 0; color: rgba(255,255,255,.78); font-size: clamp(1rem, 2vw, 1.3rem); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  .scroll-cue { position: absolute; bottom: 2rem; left: 0; display: none; align-items: center; gap: .8rem; color: rgba(255,255,255,.68); font-size: .72rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .hero-note { position: absolute; right: 0; bottom: 2rem; margin: 0; color: rgba(255,255,255,.52); font-size: .67rem; letter-spacing: .04em; }
  .introduction { background: var(--paper); }
  .intro-grid { display: grid; gap: 2rem; }
  .introduction .display { max-width: 16ch; font-size: clamp(2.7rem, 7vw, 5.6rem); }
  .introduction .display span { color: #8a897f; }
  .intro-copy { display: grid; gap: 1.25rem; max-width: 45rem; margin-top: 2rem; }
  .intro-copy p { margin: 0; font-size: clamp(1rem, 1.8vw, 1.25rem); }
  .intro-copy .demo-note { border-left: 2px solid var(--amber); padding-left: 1rem; color: var(--muted); font-size: .82rem; }
  .section-heading { display: grid; gap: 1.5rem; align-items: end; margin-bottom: clamp(2.5rem, 5vw, 4.5rem); }
  .section-heading .display { max-width: 13ch; font-size: clamp(2.8rem, 6vw, 5.5rem); }
  .section-heading > p { max-width: 35rem; margin: 0; color: var(--muted); }
  .services-home { background: var(--cream); }
  .service-grid { display: grid; gap: 2rem; }
  .service-card { overflow: hidden; background: var(--paper); box-shadow: 0 15px 40px rgba(30,29,24,.06); }
  .service-image { position: relative; display: block; overflow: hidden; aspect-ratio: 4 / 3; }
  .service-image :global(picture), .service-image :global(img) { width: 100%; height: 100%; }
  .service-image :global(img) { object-fit: cover; transition: transform .55s cubic-bezier(.2,.7,.2,1); }
  .service-card:hover .service-image :global(img) { transform: scale(1.035); }
  .service-image > span { position: absolute; right: 1rem; bottom: 1rem; display: grid; width: 3rem; height: 3rem; place-items: center; background: var(--amber); color: var(--ink); font-family: "Archivo Variable", sans-serif; font-size: .75rem; font-weight: 800; }
  .service-body { padding: 1.5rem; }
  .service-body h3 { margin: 0; font-family: "Archivo Variable", sans-serif; font-size: clamp(1.7rem, 3.2vw, 2.5rem); font-weight: 720; letter-spacing: -.04em; text-transform: uppercase; }
  .service-body > p { min-height: 4.5rem; margin: .8rem 0 1.25rem; color: var(--muted); font-size: .88rem; }
  .service-body ul { display: flex; flex-wrap: wrap; gap: .45rem; margin: 0 0 1.4rem; padding: 0; list-style: none; }
  .service-body li { border: 1px solid var(--line); border-radius: 999px; padding: .38rem .6rem; color: var(--muted); font-size: .66rem; }
  .service-body a, .text-link { display: inline-flex; align-items: center; gap: .45rem; color: var(--amber-deep); font-size: .72rem; font-weight: 800; letter-spacing: .075em; text-transform: uppercase; }
  .projects-home { background: var(--paper); }
  .section-heading--projects { margin-bottom: 1rem; }
  .project-disclaimer { max-width: 55rem; border-left: 2px solid var(--amber); margin: 0 0 3rem; padding-left: 1rem; color: var(--muted); font-size: .76rem; }
  .project-grid { display: grid; gap: clamp(2.5rem, 5vw, 5rem) 1.5rem; }
  .values-section { background: var(--ink); color: white; }
  .values-grid { display: grid; gap: 3rem; }
  .values-intro .eyebrow { color: var(--amber); }
  .values-intro .display { max-width: 14ch; font-size: clamp(2.8rem, 6vw, 5.5rem); }
  .values-intro > p:last-child { max-width: 35rem; margin: 1.5rem 0 0; color: rgba(255,255,255,.58); }
  .value-list { border-top: 1px solid rgba(255,255,255,.18); }
  .value-row { display: grid; grid-template-columns: 2.4rem 1fr auto; align-items: center; gap: .75rem; border-bottom: 1px solid rgba(255,255,255,.18); padding-block: 1.25rem; }
  .value-row span { color: var(--amber); font-family: "Archivo Variable", sans-serif; font-size: .68rem; font-weight: 740; }
  .value-row h3 { margin: 0; font-family: "Archivo Variable", sans-serif; font-size: clamp(1.4rem, 3vw, 2.3rem); font-weight: 650; letter-spacing: -.035em; text-transform: uppercase; }
  .value-row svg { color: rgba(255,255,255,.42); }
  .testimonials-section { background: var(--cream); }
  .testimonial-grid { display: grid; gap: 1rem; }
  .testimonial-card { padding: clamp(1.4rem, 3vw, 2.4rem); background: var(--paper); }
  .testimonial-card > svg { color: var(--amber); }
  .sample-label { margin: 1.5rem 0 .7rem; color: var(--amber-deep); font-size: .62rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; }
  .testimonial-card blockquote { margin: 0; font-size: clamp(1rem, 2vw, 1.2rem); font-weight: 580; line-height: 1.55; }
  .sample-person { margin: 1.5rem 0 0; color: var(--muted); font-size: .72rem; }
  .service-area-section { overflow: hidden; padding-block: clamp(4.75rem, 9vw, 8.5rem); background: var(--paper); }
  .service-area-grid { display: grid; align-items: center; gap: 3rem; }
  .area-visual { position: relative; aspect-ratio: 1; max-width: 34rem; border: 1px solid var(--line); border-radius: 50%; }
  .area-visual::before, .area-visual::after, .area-visual span { position: absolute; inset: 14%; border: 1px solid var(--line); border-radius: 50%; content: ""; }
  .area-visual::after { inset: 30%; background: var(--amber); border: 0; box-shadow: 0 0 0 1rem rgba(216,150,63,.15); }
  .area-visual span:nth-child(1) { inset: -8%; border-color: rgba(216,150,63,.32); }
  .area-visual span:nth-child(2) { inset: 43% auto auto 65%; width: .65rem; height: .65rem; background: var(--ink); border: 0; }
  .area-visual span:nth-child(3) { inset: 70% auto auto 27%; width: .45rem; height: .45rem; background: var(--amber-deep); border: 0; }
  .area-visual strong { position: absolute; right: 8%; bottom: 12%; color: var(--muted); font-family: "Archivo Variable", sans-serif; font-size: .7rem; }
  .area-copy .display { max-width: 12ch; font-size: clamp(2.8rem, 6vw, 5.4rem); }
  .area-copy > p:not(.eyebrow) { margin: 1.25rem 0 0; font-size: clamp(1rem, 2vw, 1.2rem); }
  .area-copy .area-note { border-left: 2px solid var(--amber); padding-left: 1rem; color: var(--muted); font-size: .76rem !important; }
  .area-copy .text-link { margin-top: 1.5rem; }
  @media (min-width: 48rem) { .scroll-cue { display: flex; } }
  @media (min-width: 48rem) { .project-grid { grid-template-columns: repeat(2, 1fr); } .testimonial-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 64rem) { .intro-grid { grid-template-columns: minmax(11rem, .45fr) 1.55fr; } .intro-copy { grid-template-columns: 1.35fr .65fr; gap: 3rem; } .section-heading { grid-template-columns: 1.2fr .8fr; } .service-grid { grid-template-columns: repeat(3, 1fr); } .values-grid { grid-template-columns: 1fr 1fr; } .service-area-grid { grid-template-columns: 1fr 1fr; gap: 7rem; } }
  @media (max-width: 47.99rem) { .project-grid article:nth-child(n + 5) { display: none; } }
  @media (max-width: 35rem) { .hero-actions .button { width: 100%; } .hero-note { display: none; } }
</style>
