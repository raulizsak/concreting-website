---
import { ArrowRight, Check } from '@lucide/astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import SectionCta from '../../../components/SectionCta.astro';
import { siteConfig } from '../../../config/site';
import { breadcrumbStructuredData } from '../../../lib/structuredData';

const projects = (await getCollection('projects')).sort((a, b) => b.data.order - a.data.order);
const nearbyListedAreas = ['Officer', 'Beaconsfield', 'Berwick', 'Cardinia', 'Nar Nar Goon', 'Tynong'];
---

<BaseLayout
  title="Concreting & Outdoor Services in Pakenham | Geli Construction Services"
  description="Geli Construction Services provides concreting, excavation, retaining walls and outdoor construction in Pakenham. Explore services and request a quote."
  structuredData={breadcrumbStructuredData([
    { name: 'Home', path: '/' },
    { name: 'Areas We Service', path: '/areas-we-service/' },
    { name: 'Pakenham', path: '/areas-we-service/pakenham/' },
  ])}
>
  <PageHero
    eyebrow="Pakenham Service Area"
    title="Concreting & Outdoor Construction in Pakenham"
    intro="Based in Pakenham, Geli Construction Services provides concrete and connected outdoor construction work for homes and outdoor spaces across the local area."
    visual="areas"
    compact
  />

  <nav class="breadcrumb-bar" aria-label="Breadcrumb">
    <div class="container"><a href="/">Home</a><span>/</span><a href="/areas-we-service/">Areas We Service</a><span>/</span><span aria-current="page">Pakenham</span></div>
  </nav>

  <section class="section local-intro">
    <div class="container intro-grid">
      <div data-reveal><p class="eyebrow">Local construction services</p><h2 class="display">Work around the property, from groundwork to finish</h2></div>
      <div class="intro-copy" data-reveal>
        <p>Geli’s primary operating base is Pakenham. Local homeowners can discuss focused concrete work or a wider outdoor project involving several connected services.</p>
        <p>Available work includes driveways, slabs, footpaths, side access, alfresco areas and steps, as well as excavation, stonework, outdoor tiling, retaining walls, irrigation, drainage and outdoor finishing.</p>
        <a class="button" href="/contact/?location=Pakenham%2C%20VIC%203810#quote-form">Request a Pakenham quote <ArrowRight size={18} aria-hidden="true" /></a>
      </div>
    </div>
  </section>

  <section class="section local-services">
    <div class="container">
      <div class="section-heading" data-reveal><p class="eyebrow">Services in Pakenham</p><h2 class="display">Choose the work relevant to your project</h2></div>
      <div class="service-grid">
        {siteConfig.services.map((service) => (
          <article data-reveal>
            <h3>{service.name}</h3>
            <p>{service.summary}</p>
            <ul>{service.examples.slice(0, 4).map((example) => <li><Check size={15} aria-hidden="true" />{example}</li>)}</ul>
            <a href={`/services/${service.slug}/`}>View {service.shortName} services <ArrowRight size={17} aria-hidden="true" /></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section local-projects">
    <div class="container">
      <div class="section-heading projects-heading" data-reveal>
        <div><p class="eyebrow">Genuine Geli work</p><h2 class="display">Concrete project examples</h2></div>
        <p>These projects show the type of concrete work Geli provides. A project suburb is only stated when it has been verified.</p>
      </div>
      <div class="project-grid">{projects.map((project) => <ProjectCard project={project} />)}</div>
    </div>
  </section>

  <section class="section nearby-areas">
    <div class="container nearby-grid" data-reveal>
      <div><p class="eyebrow">Surrounding service area</p><h2 class="display">Nearby listed locations</h2></div>
      <div>
        <p>Geli’s confirmed service-area data also includes the following locations around the Pakenham corridor:</p>
        <ul>{nearbyListedAreas.map((area) => <li>{area}</li>)}</ul>
        <a class="text-link" href="/areas-we-service/">View every service location <ArrowRight size={18} aria-hidden="true" /></a>
      </div>
    </div>
  </section>

  <SectionCta title="Planning work in Pakenham?" copy="Tell us the project location, the services you need and a few details about the site so Geli can discuss the scope with you." />
</BaseLayout>

<style>
  .breadcrumb-bar { border-bottom: 1px solid var(--line); background: var(--paper); }
  .breadcrumb-bar .container { display: flex; flex-wrap: wrap; gap: .45rem; padding-block: .85rem; color: var(--muted); font-size: .68rem; }
  .breadcrumb-bar a:hover { color: var(--brand-primary-strong); }
  .local-intro, .local-projects, .nearby-areas { background: var(--paper); }
  .intro-grid, .nearby-grid { display: grid; gap: clamp(2rem, 7vw, 7rem); }
  .display, .section-heading .display { max-width: 14ch; font-size: clamp(2.7rem, 5.8vw, 5.5rem); }
  .intro-copy p, .nearby-grid p { margin: 0 0 1rem; color: var(--muted); }
  .intro-copy .button { margin-top: 1rem; }
  .local-services { background: var(--brand-light); }
  .section-heading { max-width: 58rem; margin-bottom: 2.5rem; }
  .service-grid { display: grid; gap: 1rem; }
  .service-grid article { display: flex; min-height: 21rem; flex-direction: column; border-top: 3px solid var(--brand-primary); padding: 1.5rem; background: var(--paper); }
  .service-grid h3 { margin: 0; font-family: "Archivo Variable", sans-serif; font-size: 1.25rem; text-transform: uppercase; }
  .service-grid p { color: var(--muted); font-size: .8rem; }
  .service-grid ul { display: grid; gap: .4rem; margin: .5rem 0 1.25rem; padding: 0; list-style: none; }
  .service-grid li { display: flex; align-items: center; gap: .5rem; color: var(--muted); font-size: .72rem; }
  .service-grid li svg { color: var(--brand-primary-strong); }
  .service-grid a, .text-link { display: inline-flex; align-items: center; gap: .45rem; margin-top: auto; color: var(--brand-primary-strong); font-size: .68rem; font-weight: 800; letter-spacing: .07em; text-transform: uppercase; }
  .projects-heading > p { max-width: 35rem; color: var(--muted); }
  .project-grid { display: grid; gap: 3rem 1.5rem; }
  .nearby-areas { border-top: 1px solid var(--line); }
  .nearby-grid ul { display: flex; flex-wrap: wrap; gap: .5rem; margin: 1.5rem 0; padding: 0; list-style: none; }
  .nearby-grid li { border: 1px solid var(--line); padding: .5rem .7rem; background: var(--brand-light); font-size: .72rem; }
  @media (min-width: 48rem) { .service-grid { grid-template-columns: repeat(2, 1fr); } .project-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 64rem) { .intro-grid, .nearby-grid { grid-template-columns: .8fr 1.2fr; } .service-grid { grid-template-columns: repeat(3, 1fr); } .projects-heading { display: flex; max-width: none; align-items: end; justify-content: space-between; gap: 2rem; } }
</style>
