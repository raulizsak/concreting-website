---
import { getCollection, type CollectionEntry } from 'astro:content';
import ServiceDetailPage from '../../../components/ServiceDetailPage.astro';
import { siteConfig } from '../../../config/site';
import { concretingSubservicePages } from '../../../config/servicePageContent';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return concretingSubservicePages.map((content) => ({
    params: { subservice: content.slug },
    props: {
      content,
      projects: content.projectSlugs
        .map((slug) => projects.find((project) => project.data.slug === slug))
        .filter((project): project is CollectionEntry<'projects'> => Boolean(project)),
    },
  }));
}

const { content, projects } = Astro.props;
const service = siteConfig.services.find((item) => item.slug === 'concreting');
if (!service) throw new Error('Missing concreting service configuration.');
---

<ServiceDetailPage
  service={service}
  content={content}
  projects={projects}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Services', path: '/services/' },
    { name: 'Concreting', path: '/services/concreting/' },
    { name: content.eyebrow, path: `/services/concreting/${content.slug}/` },
  ]}
/>
