---
import { getCollection, type CollectionEntry } from 'astro:content';
import ServiceDetailPage from '../../components/ServiceDetailPage.astro';
import { siteConfig } from '../../config/site';
import { servicePageContent } from '../../config/servicePageContent';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return servicePageContent.map((content) => {
    const service = siteConfig.services.find((item) => item.slug === content.slug);
    if (!service) throw new Error(`Missing service configuration for ${content.slug}`);
    return {
      params: { slug: content.slug },
      props: {
        service,
        content,
        projects: content.projectSlugs
          .map((slug) => projects.find((project) => project.data.slug === slug))
          .filter((project): project is CollectionEntry<'projects'> => Boolean(project)),
      },
    };
  });
}

const { service, content, projects } = Astro.props;
---

<ServiceDetailPage
  service={service}
  content={content}
  projects={projects}
  breadcrumbs={[
    { name: 'Home', path: '/' },
    { name: 'Services', path: '/services/' },
    { name: service.name, path: `/services/${service.slug}/` },
  ]}
  isTopLevel
/>
