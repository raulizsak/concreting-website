---
import { ArrowRight, BrickWall, Check, Droplets, Layers, PanelsTopLeft, Shovel, Sprout } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import SectionCta from '../../components/SectionCta.astro';
import { siteConfig } from '../../config/site';
import { breadcrumbStructuredData } from '../../lib/structuredData';

const serviceIcons = [Layers, Shovel, PanelsTopLeft, Sprout, Droplets, BrickWall];
---

<BaseLayout
  title="Concreting & Outdoor Services Pakenham | Geli Construction Services"
  description="Explore concreting, excavation, stonework, retaining walls, drainage and outdoor finishing services in Pakenham and across South East Melbourne."
  structuredData={breadcrumbStructuredData([
    { name: 'Home', path: '/' },
    { name: 'Services', path: '/services/' },
  ])}
>
  <PageHero
    eyebrow="Services"
    title="Outdoor construction from groundwork to finish."
    intro="From concrete driveways and footpaths to excavation, stonework, retaining walls, drainage and outdoor finishing, Geli Construction Services can help with a wide range of work around your property."
    visual="services"
    compact
  />

  <section class="section services-list">
    <div class="container">
      {siteConfig.services.map((service, index) => {
        const Icon = serviceIcons[index];
        return (
          <article class:list={['service-row', index % 2 === 1 && 'service-row--reverse']} id={service.slug} data-reveal>
            <div class="service-media">
              <ResponsiveImage
                src={service.image}
                alt={service.imageAlt}
                width={service.imageWidth}
                height={service.imageHeight}
                widths={'imageWidths' in service ? service.imageWidths : undefined}
                sizes="(min-width: 64rem) 50vw, 100vw"
              />
              <div class="service-media-meta" aria-hidden="true"><span>0{index + 1}</span><Icon size={54} stroke-width={1.25} /></div>
            </div>
            <div class="service-content">
              <p class="service-index">0{index + 1} / 06</p>
              <p class="eyebrow">{service.shortName}</p>
              <h2 class="display">{service.heading}</h2>
              <p class="service-summary">{service.pageSummary}</p>
              <ul>
                {service.examples.map((example) => <li><Check size={17} stroke-width={2} aria-hidden="true" /> {example}</li>)}
              </ul>
              <div class="service-actions">
                <a class="service-detail-link" href={`/services/${service.slug}/`}>View {service.shortName} details <ArrowRight size={18} aria-hidden="true" /></a>
                <a class="button" href={`/contact/?service=${service.formValue}#quote-form`}>{service.cta} <ArrowRight size={18} aria-hidden="true" /></a>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <SectionCta
    title="Planning more than one type of work?"
    copy="Tell us about the whole project. We can discuss the different parts of the job and what needs to happen first."
  />
</BaseLayout>

<style>
  .services-list { background: var(--paper); }
  .service-row { display: grid; align-items: center; gap: clamp(2rem, 6vw, 6rem); border-top: 1px solid var(--line); padding-block: clamp(3rem, 7vw, 6rem); scroll-margin-top: 2rem; }
  .service-row > * { min-width: 0; }
  .service-row:first-child { border-top: 0; padding-top: 0; }
  .service-media { position: relative; overflow: hidden; width: 100%; min-width: 0; min-height: clamp(20rem, 42vw, 34rem); aspect-ratio: 4 / 3; background: var(--brand-dark); color: var(--brand-primary); }
  .service-media::after { position: absolute; inset: 35% 0 0; background: linear-gradient(transparent, rgba(12,11,10,.78)); content: ""; pointer-events: none; }
  .service-media :global(picture), .service-media :global(img) { display: block; width: 100%; height: 100%; }
  .service-media :global(img) { object-fit: cover; transition: transform .5s cubic-bezier(.2,.7,.2,1); }
  .service-row:hover .service-media :global(img) { transform: scale(1.025); }
  .service-media-meta { position: absolute; right: clamp(1.5rem, 4vw, 3rem); bottom: clamp(1.5rem, 4vw, 3rem); left: clamp(1.5rem, 4vw, 3rem); z-index: 1; display: flex; align-items: flex-end; justify-content: space-between; }
  .service-media-meta > span { font-family: "Archivo Variable", sans-serif; font-size: clamp(3.5rem, 8vw, 8rem); font-weight: 760; letter-spacing: -.06em; line-height: .8; opacity: .88; }
  .service-index { margin: 0 0 2rem; color: var(--muted); font-family: "Archivo Variable", sans-serif; font-size: .68rem; font-weight: 730; letter-spacing: .1em; }
  .service-content .display { max-width: 12ch; font-size: clamp(2.7rem, 6vw, 5.6rem); }
  .service-summary { max-width: 35rem; margin: 1.5rem 0 0; font-size: clamp(1rem, 1.8vw, 1.2rem); }
  .service-content ul { display: grid; gap: .6rem; margin: 1.5rem 0 2rem; padding: 0; list-style: none; }
  .service-content li { display: flex; align-items: center; gap: .7rem; color: var(--muted); font-size: .86rem; }
  .service-content li svg { flex: 0 0 auto; color: var(--brand-primary-strong); }
  .service-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; }
  .service-detail-link { display: inline-flex; align-items: center; gap: .45rem; color: var(--brand-primary-strong); font-size: .7rem; font-weight: 800; letter-spacing: .07em; text-transform: uppercase; }
  @media (min-width: 64rem) { .service-row { grid-template-columns: 1fr 1fr; } .service-row--reverse .service-media { order: 2; } .service-row--reverse .service-content { order: 1; } }
  @media (prefers-reduced-motion: reduce) { .service-media :global(img) { transition: none; } }
</style>
