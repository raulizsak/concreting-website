---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import SectionCta from '../../components/SectionCta.astro';

const projects = (await getCollection('projects')).sort((a, b) => b.data.order - a.data.order);
const filters = ['All', 'Concreting', 'Excavation', 'Stonework & Outdoor Tiling', 'Outdoor Finishing & Landscaping', 'Irrigation & Drainage', 'Retaining Walls'];
---

<BaseLayout
  title="Projects | Geli Construction Services"
  description="View genuine concreting projects completed by Geli Construction Services, including driveway, slab, backyard and side access work."
>
  <PageHero
    eyebrow="Projects"
    title="Completed work"
    intro="Explore genuine project photography from concrete work completed across driveways, backyard areas, side access and outdoor slabs."
    visual="projects"
  />

  <section class="section projects-page">
    <div class="container">
      <div class="filter-scroll" data-reveal>
        <div class="filter-bar" role="group" aria-label="Filter projects by service">
          {filters.map((filter, index) => (
            <button type="button" data-filter={filter} aria-pressed={index === 0 ? 'true' : 'false'}>{filter}</button>
          ))}
        </div>
      </div>
      <p class="filter-status" aria-live="polite">Showing all {projects.length} projects.</p>
      <div class="project-grid" data-project-grid>
        {projects.map((project, index) => <ProjectCard project={project} priority={index < 2} />)}
      </div>
      <div class="empty-state" data-empty-state hidden>
        <p class="eyebrow">More work to come</p>
        <h2>Projects coming soon</h2>
        <p>We're adding completed work to this category. Check back soon for more project photos.</p>
      </div>
      <noscript><p class="noscript-note">Project filtering needs JavaScript. All projects remain visible without it.</p></noscript>
    </div>
  </section>

  <SectionCta title="Have a project in mind?" copy="Tell us what you are planning and request a free quote." />
</BaseLayout>

<script>
  const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-category]'));
  const status = document.querySelector<HTMLElement>('.filter-status');
  const emptyState = document.querySelector<HTMLElement>('[data-empty-state]');

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const filter = button.dataset.filter ?? 'All';
      let visible = 0;
      filterButtons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      cards.forEach((card) => {
        const matches = filter === 'All' || (card.dataset.category ?? '').split('|').includes(filter);
        card.hidden = !matches;
        if (matches) visible += 1;
      });
      if (emptyState) emptyState.hidden = visible !== 0;
      if (status) status.textContent = visible === 0
        ? `No projects are published in ${filter} yet.`
        : `Showing ${visible} ${filter === 'All' ? 'projects' : `${filter.toLowerCase()} projects`}.`;
    });
  });
</script>

<style>
  .projects-page { background: var(--paper); }
  .filter-scroll { overflow-x: auto; margin-inline: -.25rem; padding: .25rem .25rem .65rem; scrollbar-width: thin; }
  .filter-bar { display: flex; width: max-content; min-width: 100%; gap: .5rem; padding-block: .15rem; }
  .filter-bar button { flex: 0 0 auto; min-height: 2.8rem; border: 1px solid var(--line); border-radius: 999px; padding: .65rem 1rem; background: transparent; color: var(--muted); font-family: "Archivo Variable", sans-serif; font-size: .68rem; font-weight: 760; letter-spacing: .08em; text-transform: uppercase; cursor: pointer; transition: background .2s ease, border-color .2s ease, color .2s ease, transform .2s ease; }
  .filter-bar button:hover, .filter-bar button:focus-visible { border-color: var(--brand-primary-strong); color: var(--brand-dark); transform: translateY(-1px); }
  .filter-bar button:focus-visible { outline: 2px solid var(--brand-primary-strong); outline-offset: 2px; }
  .filter-bar button[aria-pressed="true"] { border-color: var(--brand-dark); background: var(--brand-dark); color: white; }
  .filter-status { margin: 1rem 0 3rem; color: var(--muted); font-size: .75rem; }
  .project-grid { display: grid; gap: clamp(2.5rem, 5vw, 5rem) 1.5rem; }
  .empty-state { border: 1px solid var(--line); padding: clamp(2rem, 6vw, 5rem); background: var(--brand-light); text-align: center; }
  .empty-state[hidden] { display: none; }
  .empty-state h2 { margin: 0; font-family: "Archivo Variable", sans-serif; font-size: clamp(2rem, 5vw, 4rem); text-transform: uppercase; }
  .empty-state > p:last-child { max-width: 34rem; margin: 1rem auto 0; color: var(--muted); }
  .noscript-note { margin-top: 2rem; color: var(--muted); font-size: .75rem; }
  @media (min-width: 48rem) { .project-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (prefers-reduced-motion: reduce) { .filter-bar button { transition: none; } }
</style>
