---
import { Mail, MapPin, Phone } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import SocialLinks from '../../components/SocialLinks.astro';
import { siteConfig } from '../../config/site';
import { breadcrumbStructuredData } from '../../lib/structuredData';
---

<BaseLayout
  title="Request a Quote | Geli Construction Services Pakenham"
  description="Contact Geli Construction Services for a concreting or outdoor construction quote in Pakenham, South East Melbourne, Gippsland and surrounding areas."
  structuredData={breadcrumbStructuredData([
    { name: 'Home', path: '/' },
    { name: 'Contact', path: '/contact/' },
  ])}
>
  <PageHero
    eyebrow="Contact"
    title="Request a free quote"
    intro="Tell us what you're planning, where the project is located and the type of work you need."
    visual="contact"
  />

  <section class="section contact-section">
    <div class="container contact-grid">
      <aside class="contact-details" data-reveal>
        <p class="eyebrow">Get in touch</p>
        <h2 class="display">Let’s discuss your project.</h2>
        <p>Use the quote form or contact Geli Construction Services directly.</p>
        <div class="contact-list">
          <a href={siteConfig.phoneHref}>
            <Phone size={22} stroke-width={1.8} aria-hidden="true" />
            <span><small>Phone</small><strong>{siteConfig.phoneDisplay}</strong></span>
          </a>
          <a href={siteConfig.emailHref}>
            <Mail size={22} stroke-width={1.8} aria-hidden="true" />
            <span><small>Email</small><strong>{siteConfig.emailDisplay}</strong></span>
          </a>
          <div>
            <MapPin size={22} stroke-width={1.8} aria-hidden="true" />
            <span><small>Service area</small><strong>{siteConfig.serviceArea}</strong></span>
          </div>
        </div>
        <div class="contact-socials"><SocialLinks label="Follow us" /></div>
      </aside>

      <div class="form-panel" data-reveal>
        <div class="form-heading"><p>Free quote request</p><span>Fields marked * are required</span></div>
        <QuoteForm />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-section { background: var(--brand-light); }
  .contact-grid { display: grid; align-items: start; gap: clamp(2.5rem, 7vw, 7rem); }
  .contact-details { position: sticky; top: 2rem; }
  .contact-details .display { max-width: 11ch; font-size: clamp(2.8rem, 6vw, 5.3rem); }
  .contact-details > p:not(.eyebrow) { max-width: 35rem; margin: 1.25rem 0 0; color: var(--muted); }
  .contact-list { display: grid; border-top: 1px solid var(--line); margin-top: 2.5rem; }
  .contact-list > * { display: grid; grid-template-columns: 2.5rem minmax(0,1fr); align-items: center; gap: .5rem; border-bottom: 1px solid var(--line); padding-block: 1rem; }
  .contact-list svg { color: var(--brand-primary-strong); }
  .contact-list span { display: grid; min-width: 0; }
  .contact-list small { color: var(--muted); font-size: .62rem; font-weight: 740; letter-spacing: .08em; text-transform: uppercase; }
  .contact-list strong { font-family: "Archivo Variable", sans-serif; font-size: .88rem; font-weight: 690; overflow-wrap: anywhere; }
  .contact-socials { margin-top: 1.5rem; }
  .form-panel { padding: clamp(1.25rem, 4vw, 2.5rem); background: var(--paper); box-shadow: var(--shadow); }
  .form-heading { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .5rem; border-bottom: 1px solid var(--line); margin-bottom: 1.75rem; padding-bottom: 1rem; }
  .form-heading p, .form-heading span { margin: 0; font-size: .68rem; font-weight: 760; letter-spacing: .08em; text-transform: uppercase; }
  .form-heading span { color: var(--muted); font-weight: 550; letter-spacing: .02em; text-transform: none; }
  @media (min-width: 64rem) { .contact-grid { grid-template-columns: .8fr 1.2fr; } }
  @media (max-width: 63.99rem) { .contact-details { position: static; } }
</style>
