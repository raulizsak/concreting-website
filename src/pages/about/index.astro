---
import { ArrowRight } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionCta from '../../components/SectionCta.astro';
import { breadcrumbStructuredData } from '../../lib/structuredData';
---

<BaseLayout
  title="About Geli Construction Services | Pakenham Outdoor Construction"
  description="Learn about Geli Construction Services and its concreting, excavation, retaining wall, drainage and outdoor construction services from Pakenham."
  structuredData={breadcrumbStructuredData([
    { name: 'Home', path: '/' },
    { name: 'About', path: '/about/' },
  ])}
>
  <PageHero
    eyebrow="About Geli Construction Services"
    title="Practical outdoor construction for your property."
    intro="Geli Construction Services provides concreting and outdoor construction services across selected areas of South-East Melbourne, the Dandenong Ranges, Gippsland, Bass Coast, South Gippsland and the Latrobe Valley."
    visual="about"
    compact
  />

  <section class="section about-intro">
    <div class="container about-grid">
      <div class="brand-visual" data-reveal>
        <div class="brand-logo-shell">
          <span class="brand-ring brand-ring--outer" aria-hidden="true"></span>
          <span class="brand-ring brand-ring--inner" aria-hidden="true"></span>
          <img src="/logo/geli-construction-services-logo.webp" width="720" height="720" alt="Geli Construction Services logo" />
        </div>
        <div class="service-words" aria-hidden="true">
          <span>Concrete</span><span>Stonework</span><span>Excavation</span><span>Outdoor construction</span>
        </div>
      </div>
      <div class="about-copy" data-reveal>
        <p class="eyebrow">What we do</p>
        <h2 class="display">From preparation to the finished outdoor space.</h2>
        <p class="lead">Geli Construction Services works across a range of outdoor projects, including concrete driveways, footpaths, alfresco areas and steps, as well as excavation, stonework, outdoor tiling, retaining walls, irrigation, drainage and outdoor finishing.</p>
        <p>Projects vary from focused concrete work through to jobs involving several stages or different outdoor services. Tell us what you're planning and where the work is located so we can discuss the scope with you.</p>
        <a class="text-link" href="/contact/#quote-form">Tell us about your project <ArrowRight size={18} aria-hidden="true" /></a>
      </div>
    </div>
  </section>

  <section class="section approach-section">
    <div class="container">
      <div class="approach-heading" data-reveal>
        <p class="eyebrow">Our approach</p>
        <h2 class="display">A clear path from enquiry to next step.</h2>
      </div>
      <div class="approach-grid">
        {[
          ['Tell us about the project', 'Send through the type of work you need, the project location and the main details of the job.'],
          ['Discuss the site and scope', 'We can discuss what the project involves, the relevant services and any site details that need to be considered.'],
          ['Plan the next step', 'Once the scope is understood, we can discuss the next step for quoting and carrying out the work.'],
        ].map(([title, copy], index) => (
          <article data-reveal style={`--stagger: ${index * 70}ms`}>
            <span>0{index + 1}</span>
            <h3>{title}</h3>
            <p>{copy}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <SectionCta
    title="Need work done around your property?"
    copy="Tell us what you're planning and we can discuss the services relevant to your project."
  />
</BaseLayout>

<style>
  .about-intro { background: var(--paper); }
  .about-grid { display: grid; align-items: center; gap: clamp(2.5rem, 7vw, 7rem); }
  .about-grid > * { min-width: 0; }
  .brand-visual { position: relative; display: grid; min-height: clamp(25rem, 55vw, 37rem); place-items: center; padding: clamp(2.5rem, 8vw, 5rem); background: radial-gradient(circle at 50% 48%, rgba(252,164,12,.1), transparent 47%); }
  .brand-logo-shell { position: relative; display: grid; width: min(72vw, 23rem); aspect-ratio: 1; place-items: center; }
  .brand-logo-shell img { position: relative; z-index: 2; width: 72%; aspect-ratio: 1; border-radius: 50%; box-shadow: 0 24px 55px rgba(23,22,21,.2); }
  .brand-ring { position: absolute; border: 1px solid rgba(199,108,6,.32); border-radius: 50%; }
  .brand-ring--outer { inset: 0; }
  .brand-ring--inner { inset: 10%; border-color: rgba(23,22,21,.16); }
  .service-words { position: absolute; right: 0; bottom: 1rem; left: 0; z-index: 3; display: flex; flex-wrap: wrap; justify-content: center; gap: .45rem; }
  .service-words span { border: 1px solid var(--line); padding: .4rem .55rem; background: rgba(255,255,255,.7); color: var(--muted); font-size: .58rem; font-weight: 720; letter-spacing: .08em; text-transform: uppercase; }
  :global(.reveal-ready) .brand-visual[data-reveal] { opacity: 0; transform: scale(.96) rotate(-1deg); }
  :global(.reveal-ready) .brand-visual[data-reveal].is-revealed { opacity: 1; transform: scale(1) rotate(0); transition-duration: .7s; }
  .about-copy .display { max-width: 13ch; font-size: clamp(2.8rem, 6vw, 5.4rem); }
  .about-copy .lead { margin: 1.5rem 0 0; font-size: clamp(1.05rem, 2vw, 1.22rem); }
  .about-copy > p:not(.eyebrow):not(.lead) { margin: 1rem 0 0; color: var(--muted); font-size: .9rem; }
  .text-link { display: inline-flex; align-items: center; gap: .45rem; margin-top: 1.5rem; color: var(--brand-primary-strong); font-size: .72rem; font-weight: 800; letter-spacing: .075em; text-transform: uppercase; }
  .approach-section { background: var(--brand-light); }
  .approach-heading { margin-bottom: 2.25rem; }
  .approach-heading .display { max-width: 14ch; font-size: clamp(2.8rem, 6vw, 5.5rem); }
  .approach-grid { display: grid; gap: 1rem; }
  .approach-grid article { min-height: 15rem; border-top: 3px solid var(--brand-primary); padding: 1.5rem; background: var(--paper); transition-delay: var(--stagger, 0ms); }
  .approach-grid article > span { color: var(--brand-primary-strong); font-family: "Archivo Variable", sans-serif; font-size: .68rem; font-weight: 760; }
  .approach-grid h3 { margin: 3.25rem 0 .75rem; font-family: "Archivo Variable", sans-serif; font-size: 1.5rem; font-weight: 700; letter-spacing: -.035em; text-transform: uppercase; }
  .approach-grid p { margin: 0; color: var(--muted); font-size: .82rem; }
  @media (min-width: 48rem) { .approach-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 64rem) { .about-grid { grid-template-columns: 1fr 1fr; } }
  @media (prefers-reduced-motion: reduce) { :global(.reveal-ready) .brand-visual[data-reveal], :global(.reveal-ready) .brand-visual[data-reveal].is-revealed { opacity: 1; transform: none; transition: none; } }
</style>
